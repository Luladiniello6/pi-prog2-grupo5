<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<%- include('./partials/head') %>

	<body>
		<!-- Header -->
		<% if (locals.user !=undefined) { %>
			<%- include("./partials/headerLogueado") %>
				<% } else { %>
					<%- include("./partials/header") %>
						<% } %>
							<!-- Header -->

							<!-- product detail -->
							<div class="container products-wrapper">
								<div class="d-flex align-items-center">
									<h2 class="products-title">
										<%= producto.nombre %>
									</h2>
									<% if(locals.user && locals.user.id==producto.idUsuario) { %>
										<a href="/productos/editarproducto/<%= producto.id %>" class="editar-link">
											Editar </a>
										<form action="/productos/eliminarproducto/<%= producto.id %>" method="post">
											<button type="submit">
												Eliminar
											</button>
										</form>
										<% } %>

								</div>
								<div class="product-detail">
									<div class="row">
										<article class="col-12 col-lg-8 product-detail-info">
											<img src="/<%= producto.foto %>" alt="<%= producto.nombre %>"
												class="product-detail-img">
											<p class="product-detail-description">
												<%= producto.descripcion %>
											</p>
										</article>
										<div class="col-12 col-lg-4">
											<section class="comments">

												<% for( let i=0; i < producto.comentarios.length; i++ ) { %>

													<article>
														<img src="<%= producto.comentarios[i].fotoUsuario %>" alt="">
														<div>
															<p class="user">
																<strong> <a href="/users/profile">
																		<%= producto.comentarios[i].usuario %>
																	</a></strong>
																<%= producto.comentarios[i].comentario %>
															</p>
														</div>

													</article>
													<% } %>

											</section>

											<% if(locals.user){%>
												<form action="/productos/comentario/<%= producto.id %>" method="post">
													<input class="form-input" type="text" name="comentario"
														placeholder="Agregar comentario" required>
													<button type="submit" class="buy-now-button">
														Agregar comentario
													</button>
												</form>
												<% } else { %>
													<a href="/users/login">
														Iniciar sesión para comentar
													</a>
													<% } %>
										</div>
									</div>
								</div>
							</div>
							<!-- /product detail -->

							<!-- footer -->
							<%- include('./partials/footer') %>
								<!-- /footer -->
	</body>

</html>