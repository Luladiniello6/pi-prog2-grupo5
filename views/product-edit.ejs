<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<%- include("./partials/head") %>

	<body>
		<!-- Header -->
		<% if (locals.userLogged !=undefined) { %>
			<%- include("./partials/headerLogueado") %>
				<% } else { %>
					<%- include("./partials/header") %>
						<% } %>
							<!-- Header -->

							<!-- Novedades -->
							<div class="container products-wrapper">
								<div class="row">
									<div class="col-12">
										<h2 class="products-title">Editar datos del producto</h2>
									</div>
									<!-- Show the "ultimos" products -->
									<form method="post" action="/productos/editarproducto/<%= producto.id %>" class="form-register">
										<div>
											<label for="foto">Imagen:</label>
											<input type="text" name="foto" id="foto" value="<%= producto.fotoDeImagen %>" >
										</div>

										<div>
											<label for="nombre">Nombre:</label>
											<input type="text" name="nombre" id="nombre" value="<%= producto.nombre %>" >
										</div>

										<div>
											<label for="descripcion">Descripcion:</label>
											<input type="text" name="descripcion" id="descripcion" value="<%= producto.descripcion %>" >
										</div>

										<div>
											<button type="submit" class="boton">Guardar cambios</button>
										</div>
									</form>


									<!-- footer -->
									<%- include('./partials/footer') %>
										<!-- /footer -->
	</body>

</html>